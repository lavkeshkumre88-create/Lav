rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          'email' in request.auth.token &&
          'email_verified' in request.auth.token &&
          request.auth.token.email == 'lavkeshkumre88@gmail.com' &&
          request.auth.token.email_verified == true
        )
      );
    }

    function isValidUserAccount(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 160 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.planTier in ['FREE', 'PRO_1TB', 'ULTRA_2TB'] &&
             data.quotaBytes is int && data.quotaBytes >= 107374182400 && data.quotaBytes <= 2199023255552 &&
             data.usedBytes is int && data.usedBytes >= 0 && data.usedBytes <= data.quotaBytes &&
             data.totalUploads is int && data.totalUploads >= 0 &&
             data.totalDownloads is int && data.totalDownloads >= 0 &&
             data.role in ['USER', 'ADMIN'] &&
             data.accountStatus in ['ACTIVE', 'SUSPENDED'] &&
             data.autoBackupPhotos is bool &&
             data.autoBackupVideos is bool &&
             data.wifiOnlyBackup is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidVaultFile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
             data.kind in ['FOLDER', 'PHOTO', 'VIDEO', 'PDF', 'DOCUMENT'] &&
             data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 120 &&
             data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 10737418240 &&
             data.parentFolderId is string && data.parentFolderId.size() <= 128 &&
             data.favorite is bool &&
             data.trashed is bool &&
             data.cloudSynced is bool &&
             data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 10 &&
             data.sha256 is string && data.sha256.size() <= 64 &&
             data.localRelativePath is string && data.localRelativePath.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFileChunk(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.index is int && data.index >= 0 && data.index < 10 &&
             data.data is string && data.data.size() >= 1 && data.data.size() <= 600000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidSharedLink(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.fileId is string && data.fileId.size() >= 1 && data.fileId.size() <= 128 &&
             data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200 &&
             data.kind in ['FOLDER', 'PHOTO', 'VIDEO', 'PDF', 'DOCUMENT'] &&
             data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 120 &&
             data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 10737418240 &&
             data.passwordProtected is bool &&
             data.passwordHash is string && data.passwordHash.size() <= 64 &&
             data.expiresAtMillis is int && data.expiresAtMillis >= 0 &&
             data.revoked is bool &&
             data.accessCount is int && data.accessCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidActivityLog(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 160 &&
             data.action in ['UPLOAD', 'DOWNLOAD', 'SHARE', 'DELETE', 'RESTORE', 'PLAN_INQUIRY', 'BACKUP'] &&
             data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 200 &&
             data.bytes is int && data.bytes >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      // New user initializes strictly with 100GB FREE tier and USER role
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'email', 'planTier', 'quotaBytes',
                         'usedBytes', 'totalUploads', 'totalDownloads', 'role',
                         'accountStatus', 'autoBackupPhotos', 'autoBackupVideos',
                         'wifiOnlyBackup', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'photoUrl', 'planTier', 'quotaBytes',
                         'usedBytes', 'totalUploads', 'totalDownloads', 'role',
                         'accountStatus', 'autoBackupPhotos', 'autoBackupVideos',
                         'wifiOnlyBackup', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserAccount(incoming(), userId) &&
                       incoming().planTier == 'FREE' &&
                       incoming().quotaBytes == 107374182400 &&
                       incoming().usedBytes == 0 &&
                       incoming().totalUploads == 0 &&
                       incoming().totalDownloads == 0 &&
                       incoming().role == 'USER' &&
                       incoming().accountStatus == 'ACTIVE';

      // Users cannot self-upgrade planTier/quotaBytes or change role/accountStatus
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserAccount(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (
                           isOwner(userId) &&
                           existing().accountStatus == 'ACTIVE' &&
                           incoming().planTier == existing().planTier &&
                           incoming().quotaBytes == existing().quotaBytes &&
                           incoming().role == existing().role &&
                           incoming().accountStatus == existing().accountStatus &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'displayName', 'email', 'photoUrl', 'usedBytes',
                             'totalUploads', 'totalDownloads', 'autoBackupPhotos',
                             'autoBackupVideos', 'wifiOnlyBackup', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      match /files/{fileId} {
        allow get: if isValidId(fileId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId) &&
                         isValidId(fileId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'kind', 'mimeType', 'sizeBytes',
                           'parentFolderId', 'favorite', 'trashed', 'cloudSynced',
                           'chunkCount', 'sha256', 'localRelativePath', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'kind', 'mimeType', 'sizeBytes',
                           'parentFolderId', 'favorite', 'trashed', 'cloudSynced',
                           'chunkCount', 'sha256', 'localRelativePath', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidVaultFile(incoming(), userId) &&
                         (incoming().sizeBytes == 0 ||
                           getAfter(/databases/$(database)/documents/users/$(userId)).data.usedBytes <=
                           getAfter(/databases/$(database)/documents/users/$(userId)).data.quotaBytes);

        allow update: if isSignedIn() &&
                         isValidId(fileId) &&
                         isValidVaultFile(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           isAdmin() ||
                           (
                             isOwner(userId) &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'name', 'parentFolderId', 'favorite', 'trashed',
                               'cloudSynced', 'chunkCount', 'updatedAt'
                             ])
                           )
                         );

        allow delete: if isValidId(fileId) && (isOwner(userId) || isAdmin());

        match /chunks/{chunkId} {
          allow get: if isValidId(fileId) && isValidId(chunkId) && isOwner(userId);
          allow list: if isValidId(fileId) && isOwner(userId);
          allow create: if isOwner(userId) &&
                           isValidId(fileId) &&
                           isValidId(chunkId) &&
                           incoming().keys().hasAll(['userId', 'index', 'data', 'createdAt']) &&
                           incoming().keys().hasOnly(['userId', 'index', 'data', 'createdAt']) &&
                           isValidFileChunk(incoming(), userId);
          allow update: if false;
          allow delete: if isValidId(fileId) && isValidId(chunkId) && (isOwner(userId) || isAdmin());
        }
      }
    }

    match /sharedLinks/{linkId} {
      allow get: if isSignedIn() && isValidId(linkId) && (
        existing().userId == request.auth.uid ||
        isAdmin() ||
        existing().revoked == false
      );
      allow list: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
                       isValidId(linkId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'fileId', 'fileName', 'kind', 'mimeType', 'sizeBytes',
                         'passwordProtected', 'passwordHash', 'expiresAtMillis', 'revoked',
                         'accessCount', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'fileId', 'fileName', 'kind', 'mimeType', 'sizeBytes',
                         'passwordProtected', 'passwordHash', 'expiresAtMillis', 'revoked',
                         'accessCount', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidSharedLink(incoming()) &&
                       incoming().accessCount == 0 &&
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)/files/$(incoming().fileId));

      allow update: if isSignedIn() &&
                       isValidId(linkId) &&
                       isValidSharedLink(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().fileId == existing().fileId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (
                           existing().userId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'passwordProtected', 'passwordHash', 'expiresAtMillis', 'revoked', 'updatedAt'
                           ])
                         ) ||
                         (
                           existing().revoked == false &&
                           incoming().accessCount == existing().accessCount + 1 &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['accessCount', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(linkId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && request.auth.uid == adminUid;
      allow list, write: if false;
    }

    match /activityLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(logId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'userEmail', 'action', 'targetName', 'bytes', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'userEmail', 'action', 'targetName', 'bytes', 'createdAt']) &&
                       isValidActivityLog(incoming());
      allow update, delete: if false;
    }
  }
}
